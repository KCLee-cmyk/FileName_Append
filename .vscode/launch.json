{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run app (python -m filesuffix.app)",
      "type": "debugpy",
      "request": "launch",
      "module": "filesuffix.app",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Run tests (python -m pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "-q"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    }
  ]
}
